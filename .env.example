# LN Operator — environment file
# Copy to .env (chmod 600) and fill in the values you need.
# All keys here are read via os.getenv(), so anything you leave out
# falls back to the defaults shown in config.py / dashboard/app.py.

# ─── LND connection (required) ────────────────────────────────
LND_REST_URL=https://127.0.0.1:9000
LND_CERT=/home/lnd/tls.cert
LND_MACAROON=/home/lnd/data/chain/bitcoin/mainnet/admin.macaroon

# ─── Telegram notifications (optional) ────────────────────────
# Pipeline alerts, fee updates, daily checks. Leave blank to disable.
# Create a bot via @BotFather, then talk to @userinfobot for your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Database location (optional) ─────────────────────────────
# Defaults to ./ln_operator.db beside main.py. Uncomment to relocate.
# LN_OPERATOR_DB=/var/lib/ln-operator/ln_operator.db

# ─── Off-site channel.backup upload (optional but recommended) ─
# Pushed by backup.py over rsync/ssh on every channel.backup rewrite
# (inotify) plus a 2h heartbeat timer. Leave BACKUP_SSH_HOST blank to
# disable. SSH key auth assumed — no password support.
BACKUP_SOURCE_PATH=/home/lnd/lnd-backup/channel.backup
BACKUP_SSH_HOST=
BACKUP_SSH_USER=
BACKUP_SSH_PORT=22
BACKUP_DEST_DIR=

# ─── Dashboard bind address ───────────────────────────────────
# Default 127.0.0.1:4000 (loopback only). Set BIND_IP to your Tailscale
# IP to expose tailnet-only. Do NOT bind to 0.0.0.0 on a residential
# WAN — the dashboard has no auth.
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=4000
