# Secrets — never commit these
.env

# Local tool/editor config (may hold machine-specific paths, IPs, hostnames)
.claude/

# Database — stays on the Pi
*.db
*.db-shm
*.db-wal
*.db.bak*

# Local baselines (channel state snapshots) — stays on the Pi
baselines/

# Network graph cache (B1) — regenerated from LND, stays on the Pi
graph_cache.json
graph_cache.json.tmp

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
cron.log
*.log

# Screenshots / images — kept local, not committed
*.png
*.jpg
*.jpeg

# …except the curated dashboard screenshots used in the README
!docs/screenshots/
!docs/screenshots/*.png
