# ── INSTALL: replace "youruser" with your Linux username, and adjust the
# /home/youruser/ln-operator paths if your clone lives elsewhere. Copy this file
# to /etc/systemd/system/ and run: sudo systemctl daemon-reload
# See the README "Install the systemd services" section.
[Unit]
Description=Push LND channel.backup off-site (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=youruser
Group=youruser
WorkingDirectory=/home/youruser/ln-operator
ExecStart=/home/youruser/ln-operator/venv/bin/python3 /home/youruser/ln-operator/main.py backup --trigger %i
Nice=10
