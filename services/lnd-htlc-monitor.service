[Unit]
Description=LN Operator — HTLC failure monitor (records dropped forwards)
Requires=network-online.target
After=network-online.target lnd.service

[Service]
User=pi
Group=pi
Type=simple
WorkingDirectory=/home/pi/ln-operator
ExecStart=/home/pi/ln-operator/venv/bin/python3 /home/pi/ln-operator/main.py monitor_htlcs
Restart=always
RestartSec=10
Environment=HOME=/home/pi
EnvironmentFile=/home/pi/ln-operator/.env

[Install]
WantedBy=multi-user.target
